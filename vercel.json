{
  "crons": [
    {
      "path": "/api/cron/daily-summary",
      "schedule": "0 7 * * *"
    }
  ],
  "redirects": [
    {
      "//": "The app domain is the product, not a brochure. Without these, app.adunadialer.com/ served the AIIS trucking-insurance landing page. Scoped by host so fleet.ins2day.com keeps serving its own marketing site at /.",
      "source": "/",
      "has": [{ "type": "host", "value": "app.adunadialer.com" }],
      "destination": "/login.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "app.adunadialer.com" }],
      "destination": "/login.html",
      "permanent": false
    },
    { "source": "/lib/:path*", "destination": "/", "permanent": false },
    { "source": "/scripts/:path*", "destination": "/", "permanent": false },
    { "source": "/supabase/:path*", "destination": "/", "permanent": false }
  ]
}
